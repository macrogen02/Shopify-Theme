<section class="hero-tech section">
  <div class="hero-content">
    <p class="eyebrow">Limited Time Offer</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    <a class="btn btn-primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Hero Tech",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Up to 40% Off – Latest Tech Deals"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Upgrade your setup with premium devices and accessories."},
    {"type": "text", "id": "button_label", "label": "Button Label", "default": "Shop Deals"},
    {"type": "url", "id": "button_link", "label": "Button Link"}
  ],
  "presets": [{"name": "Hero Tech"}]
}
{% endschema %}
